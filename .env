# FPGA synthesis/program defaults
N=4
TILE_SIZE=4
NUM_MACS=4
DATA_WIDTH=8
ACC_WIDTH=32
MEM_TYPE=external_sdram
DATAFLOW=output_stationary
BUFFERING_MODE=single
MEMORY_BURST_LEN=1
MAC_PIPELINE_STAGES=0
MEMORY_BANKS_A=1
MEMORY_BANKS_B=1
CLKS_PER_BIT=50
CLK_FREQ_HZ=50000000
UART_FIFO_DEPTH=64
SDRAM_ADDR_W=26
SDRAM_DATA_W=32
SDRAM_SIMULATION_MODEL=false
ACCUMULATE_C=false
ENABLE_SIGNALTAP=false

# synth_fpga.ps1 switches
CLEAN=true
UPDATE_PYTHON_ENV=true
PROGRAM=true
PROGRAM_ONLY=false

# Python matrix/vector defaults
NUM_TESTS=1
SEED=123
MIN_VALUE=-1
MAX_VALUE=1

# Python UART host defaults
UART_PORT=COM3
UART_BAUDRATE=1000000
UART_TIMEOUT=300
LOAD_MODE=stream
STREAM_MODE=interleaved
STREAM_CHUNK_ELEMS=4096
READ_MODE=stream
C_STREAM_CHUNK_ELEMS=4096
READ_COUNTERS=true
