# -----------------------------------------------------------------------------
# Project: fpga_matrix_accelerator
# Board  : Terasic DE0-CV
# FPGA   : Cyclone V 5CEBA4F23C7 / physical board part 5CEBA4F23C7N
# Top    : matrix_accelerator_full_top
# -----------------------------------------------------------------------------

# -----------------------------
# Global project assignments
# -----------------------------
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CEBA4F23C7
set_global_assignment -name TOP_LEVEL_ENTITY matrix_accelerator_full_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS 8
set_global_assignment -name VHDL_INPUT_VERSION VHDL_2008
set_global_assignment -name SDC_FILE fpga_matrix_accelerator.sdc

set_global_assignment -name ORIGINAL_QUARTUS_VERSION 25.1STD.0
set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 256
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"

# -----------------------------
# VHDL source files
# -----------------------------
set_global_assignment -name VHDL_FILE rtl/common/matrix_tiled_pkg.vhd
set_global_assignment -name VHDL_FILE rtl/common/matrix_accel_config_pkg.vhd
set_global_assignment -name VHDL_FILE rtl/common/perf_counters.vhd
set_global_assignment -name VHDL_FILE rtl/common/accelerator_status_leds.vhd
set_global_assignment -name VHDL_FILE rtl/common/sigma_hex_display.vhd
set_global_assignment -name VHDL_FILE rtl/compute/mac_unit.vhd
set_global_assignment -name VHDL_FILE rtl/compute/matrix_tiled_compute_core.vhd
set_global_assignment -name VHDL_FILE rtl/memory/matrix_single_port_ram.vhd
set_global_assignment -name VHDL_FILE rtl/control/command_interface.vhd
set_global_assignment -name VHDL_FILE rtl/uart/uart_rx.vhd
set_global_assignment -name VHDL_FILE rtl/uart/uart_tx.vhd
set_global_assignment -name VHDL_FILE rtl/uart/uart_byte_fifo.vhd
set_global_assignment -name VHDL_FILE rtl/debug/signaltap_debug_core.vhd
set_global_assignment -name VHDL_FILE rtl/compute/matrix_mult_tiled_core.vhd
set_global_assignment -name VHDL_FILE rtl/top/matrix_accelerator_full_top.vhd

# -----------------------------
# Clock input
# DE0-CV CLOCK_50 -> PIN_M9
# -----------------------------
set_location_assignment PIN_M9 -to clk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk

# -----------------------------
# Control inputs
# Usando switches, porque o RTL usa rst/start ativos em nivel alto.
# SW0 -> rst
# SW1 -> start_button
# -----------------------------
set_location_assignment PIN_U13 -to rst
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to rst

set_location_assignment PIN_V13 -to start_button
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to start_button

# -----------------------------
# UART over GPIO header JP1
# GPIO_0_D0 -> uart_rx_i
# GPIO_0_D1 -> uart_tx_o
# ATENCAO: UART em nivel logico 3.3 V TTL, nao RS-232 direto.
# -----------------------------
set_location_assignment PIN_N16 -to uart_rx_i
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to uart_rx_i

set_location_assignment PIN_B16 -to uart_tx_o
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to uart_tx_o

# -----------------------------
# LEDs
# -----------------------------
set_location_assignment PIN_AA2 -to LEDR[0]
set_location_assignment PIN_AA1 -to LEDR[1]
set_location_assignment PIN_W2 -to LEDR[2]
set_location_assignment PIN_Y3 -to LEDR[3]
set_location_assignment PIN_N2 -to LEDR[4]
set_location_assignment PIN_N1 -to LEDR[5]
set_location_assignment PIN_U2 -to LEDR[6]
set_location_assignment PIN_U1 -to LEDR[7]
set_location_assignment PIN_L2 -to LEDR[8]
set_location_assignment PIN_L1 -to LEDR[9]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LEDR[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LEDR[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LEDR[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LEDR[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LEDR[4]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LEDR[5]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LEDR[6]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LEDR[7]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LEDR[8]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LEDR[9]

