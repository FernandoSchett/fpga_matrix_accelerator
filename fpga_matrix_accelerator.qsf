set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CEBA4F23C7
set_global_assignment -name TOP_LEVEL_ENTITY matrix_accelerator_full_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS 8
set_global_assignment -name VHDL_INPUT_VERSION VHDL_2008

set_global_assignment -name ORIGINAL_QUARTUS_VERSION 25.1STD.0
set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 256
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"

set_global_assignment -name VHDL_FILE rtl/common/matrix_tiled_pkg.vhd
set_global_assignment -name VHDL_FILE rtl/common/matrix_accel_config_pkg.vhd
set_global_assignment -name VHDL_FILE rtl/common/perf_counters.vhd
set_global_assignment -name VHDL_FILE rtl/common/accelerator_status_leds.vhd
set_global_assignment -name VHDL_FILE rtl/compute/mac_unit.vhd
set_global_assignment -name VHDL_FILE rtl/compute/matrix_tiled_compute_core.vhd
set_global_assignment -name VHDL_FILE rtl/memory/matrix_single_port_ram.vhd
set_global_assignment -name VHDL_FILE rtl/control/command_interface.vhd
set_global_assignment -name VHDL_FILE rtl/uart/uart_rx.vhd
set_global_assignment -name VHDL_FILE rtl/uart/uart_tx.vhd
set_global_assignment -name VHDL_FILE rtl/top/matrix_mult_tiled_top.vhd
set_global_assignment -name VHDL_FILE rtl/top/matrix_accelerator_full_top.vhd

set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top
