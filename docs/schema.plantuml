@startuml
title matrix_accelerator_full_top - Fluxo do Acelerador de Matrizes

left to right direction

skinparam componentStyle rectangle
skinparam linetype ortho
skinparam shadowing false
skinparam defaultFontName Arial

skinparam nodesep 120
skinparam ranksep 140
skinparam padding 15
skinparam rectanglePadding 16
skinparam packagePadding 25

' =========================
' External system
' =========================

rectangle "PC / Host" as PC #F8F9FA

rectangle "Entradas do sistema\n\nclk\nrst\nuart_rx_i\nstart_button" as INPUTS #F8F9FA

rectangle "Saídas do sistema\n\nuart_tx_o\nbusy_led\ndone_led\nLEDR[9:0]" as OUTPUTS #F8F9FA

rectangle "PC / Host\nrecebe resultado" as PC_OUT #F8F9FA

' =========================
' Top-level
' =========================

package "matrix_accelerator_full_top" #FFFFFF {

    rectangle "UART de entrada\nu_uart_rx" as UART_IN #EAF2F8

    rectangle "UART de retorno\nu_uart_tx" as UART_OUT #EAF2F8

    rectangle "Interface de comando\ne carga de dados\nu_command" as CMD #E8F6F3

    rectangle "Controle de início/fim\naccel_start logic\ndone_seen process" as CTRL #FEF5E7

    rectangle "Status visual\nu_status_leds" as STATUS #FDEDEC

    package "Núcleo do acelerador\nu_core / matrix_accelerator_sdram_core_top" #F4ECF7 {

        rectangle "SDRAM externa / modelo SDRAM\nsdram_model" as SDRAM #EBDEF0

        rectangle "Controlador de blocos\nTile Scheduler\naccelerator_controller" as SCHED #D7BDE2

        rectangle "Memória interna M10K\npara tiles" as M10K #D6EAF8

        rectangle "Array de MACs\nusando DSPs" as MACS #D5F5E3

        rectangle "Acumuladores /\nRedução" as ACC #FCF3CF

        rectangle "Memória de resultado\nC matrix" as RESULT #FADBD8
    }
}

' =========================
' Layout hints
' =========================

PC -[hidden]right- INPUTS
INPUTS -[hidden]right- UART_IN
UART_IN -[hidden]right- CMD
CMD -[hidden]right- SDRAM
SDRAM -[hidden]right- SCHED
SCHED -[hidden]right- M10K
M10K -[hidden]right- MACS
MACS -[hidden]right- ACC
ACC -[hidden]right- RESULT
RESULT -[hidden]right- UART_OUT
UART_OUT -[hidden]right- OUTPUTS
OUTPUTS -[hidden]right- PC_OUT

CTRL -[hidden]down- STATUS

' =========================
' External UART input path
' =========================

PC --> INPUTS : matriz A/B e comandos
INPUTS --> UART_IN : uart_rx_i

UART_IN --> CMD : rx_valid
UART_IN --> CMD : rx_byte

' =========================
' Command and loading path
' =========================

CMD --> SDRAM : escrita das matrizes A/B
CMD --> CTRL : cmd_start
INPUTS --> CTRL : start_button

CTRL --> SCHED : accel_start

' =========================
' Core computation path
' =========================

SDRAM --> SCHED : dados dos blocos
SCHED --> M10K : tiles A/B
M10K --> MACS : operandos
MACS --> ACC : produtos parciais
ACC --> RESULT : resultado acumulado
RESULT --> SDRAM : escrita da matriz C

' =========================
' Readback path
' =========================

SDRAM --> CMD : leitura da matriz C
CMD --> UART_OUT : tx_byte
CMD --> UART_OUT : tx_start
UART_OUT --> CMD : tx_busy

UART_OUT --> OUTPUTS : uart_tx_o
OUTPUTS --> PC_OUT : resultado via UART

' =========================
' Status path
' =========================

SCHED --> CTRL : accel_done
SCHED --> CMD : accel_busy
CTRL --> CMD : done_seen

SCHED --> STATUS : load_active
SCHED --> STATUS : compute_active
SCHED --> STATUS : store_active
SCHED --> STATUS : tile_done

SCHED --> STATUS : tiles_processed
STATUS --> OUTPUTS : LEDR[9:0]

SCHED --> OUTPUTS : busy_led
CTRL --> OUTPUTS : done_led

' =========================
' Global control
' =========================

INPUTS ..> UART_IN : clk, rst
INPUTS ..> UART_OUT : clk, rst
INPUTS ..> CMD : clk, rst
INPUTS ..> CTRL : clk, rst
INPUTS ..> SCHED : clk, rst
INPUTS ..> STATUS : clk, rst

@enduml