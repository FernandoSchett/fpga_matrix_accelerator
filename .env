# FPGA synthesis/program defaults
N=4
TILE_SIZE=4
NUM_MACS=4
DATA_WIDTH=8
ACC_WIDTH=32
MEM_TYPE=external_sdram
DATAFLOW=output_stationary
BUFFERING_MODE=double
MEMORY_BURST_LEN=4
MAC_PIPELINE_STAGES=0
MEMORY_BANKS_A=2
MEMORY_BANKS_B=2
CLKS_PER_BIT=50
CLK_FREQ_HZ=50000000
UART_FIFO_DEPTH=64
SDRAM_ADDR_W=26
SDRAM_DATA_W=32
SDRAM_SIMULATION_MODEL=false
ACCUMULATE_C=false
ENABLE_SIGNALTAP=false

# synth_fpga.ps1 switches
CLEAN=true
PROGRAM=true
PROGRAM_ONLY=false
